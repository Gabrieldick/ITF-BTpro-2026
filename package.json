{
  "name": "ponto-de-ouro",
  "private": true,
  "version": "36.0.0",
  "description": "Jogo de beach tennis 3D (three.js)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:single": "node scripts/build-single.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
